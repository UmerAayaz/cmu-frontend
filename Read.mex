/* ================= My Team Page Specific ================= */

/* --- Top Metrics Grid --- */
.mt-metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 24px;
}

.mt-metric-card {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mt-metric-value {
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
}

/* Custom colors for metric numbers */
.mt-val-red { color: var(--primary-red); }
.mt-val-dark { color: #1f2937; }
.mt-val-green { color: #16a34a; }
.mt-val-orange { color: #d97706; }

.mt-metric-label {
  font-size: 13px;
  color: #6b7280;
  font-weight: 500;
}

.mt-metric-label span {
  color: #9ca3af;
  font-weight: 400;
}

/* --- Search Bar --- */
.mt-search-container {
  width: 350px;
  margin-bottom: 20px;
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  display: flex;
  align-items: center;
  padding: 10px 12px;
  gap: 8px;
}

.mt-search-container input {
  border: none;
  background: transparent;
  padding: 0;
  font-size: 13px;
  outline: none;
  width: 100%;
}

/* --- Table Container --- */
.mt-table-container {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 16px;
}

.mt-table-header {
  display: flex;
  padding: 14px 20px;
  background: #f9fafb;
  font-size: 12px;
  font-weight: 600;
  color: #9ca3af;
  border-bottom: 1px solid var(--border-color);
  letter-spacing: 0.5px;
  align-items: center;
}

.mt-table-row {
  display: flex;
  padding: 16px 20px;
  align-items: center;
  border-bottom: 1px solid var(--border-color);
  transition: background 0.2s;
}

.mt-table-row:hover {
  background: #f9fafb;
}

.mt-table-row:last-child {
  border-bottom: none;
}

/* --- Officer Info --- */
.mt-officer-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.mt-avatar {
  width: 36px;
  height: 36px;
  background: var(--primary-red);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  flex-shrink: 0;
}

.mt-officer-name {
  font-weight: 600;
  font-size: 14px;
  color: var(--text-main);
}

.mt-officer-role {
  font-size: 12px;
  color: #9ca3af;
}

/* --- Progress Bar --- */
.mt-progress-wrapper {
  flex: 1;
  max-width: 250px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.mt-progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-progress-text {
  font-size: 12px;
  color: #6b7280;
}

.mt-progress-track {
  width: 100%;
  height: 6px;
  background: #e5e7eb;
  border-radius: 3px;
  overflow: hidden;
}

.mt-progress-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.3s ease;
}

/* Progress Bar Colors */
.bg-green { background-color: #16a34a; }
.bg-orange { background-color: #d97706; }
.bg-red { background-color: #dc2626; }

/* --- Badges & Text --- */
.mt-badge-ontarget {
  background: #dcfce7;
  color: #15803d;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
}

.mt-badge-overdue {
  background: #fee2e2;
  color: #b91c1c;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
}

.mt-tat-text {
  font-size: 13px;
  font-weight: 500;
}

.mt-tat-green { color: #16a34a; }
.mt-tat-orange { color: #d97706; }
.mt-tat-gray { color: #9ca3af; }

/* --- Footer Info Banner --- */
.mt-info-banner {
  background: #f9fafb;
  border: 1px solid var(--border-color);
  padding: 12px 20px;
  border-radius: 6px;
  font-size: 13px;
  color: #6b7280;
  margin-bottom: 32px;
}

/* --- Team Lead Card (Bottom) --- */
.mt-lead-section {
  margin-top: 32px;
}

.mt-lead-label {
  font-size: 12px;
  color: #9ca3af;
  font-weight: 600;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.mt-lead-card {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mt-lead-avatar {
  width: 36px;
  height: 36px;
  background: #fca5a5; /* Lighter red for TL */
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
}

.mt-lead-managing {
  font-size: 13px;
  color: #6b7280;
}
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
import { useState, useEffect } from 'react';
// import axios from 'axios'; 
import { Plus, ChevronDown, ChevronRight, Folder, Layers, Tag, Unlink, Link as LinkIcon, AlertTriangle, Edit } from 'lucide-react';
import toast from 'react-hot-toast';
import Modal from '../components/ui/Modal';
import '../styles/workflow-module.css';

// Mock Data
let MOCK_DATA = [
  { id: 1, name: "Project Status", code: "PS", parentListId: null, parentListName: "" },
  { id: 2, name: "test", code: "test3", parentListId: 1, parentListName: "Project Status" },
  { id: 4, name: "Category 2", code: "category", parentListId: null, parentListName: "" },
  { id: 99, name: "ewewewe", code: "orphan_product_ewewewe", parentListId: null, parentListName: "" },
  { id: 100, name: "adasd", code: "orphan_product_adasd", parentListId: null, parentListName: "" },
];

export default function Lookups() {
  const [categories, setCategories] = useState([]);
  const [detachedItems, setDetachedItems] = useState([]);
  
  const [expandedCats, setExpandedCats] = useState([]); 
  const [expandedSubs, setExpandedSubs] = useState([]);

  // ADD Modal State
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [modalMode, setModalMode] = useState('category'); 
  const [activeParent, setActiveParent] = useState(null); 
  const [formData, setFormData] = useState({ name: '' });

  const [isIndependent, setIsIndependent] = useState(false); 
  const [independentType, setIndependentType] = useState('sub'); 

  // LINK (Connect) Modal State
  const [isLinkModalOpen, setIsLinkModalOpen] = useState(false);
  const [editingItem, setEditingItem] = useState(null);
  const [selectedParentId, setSelectedParentId] = useState("");

  // 1. Fetch & Build Tree
  const fetchLookups = () => {
    const normalData = MOCK_DATA.filter(item => !item.code || !item.code.startsWith('orphan_'));
    const orphanData = MOCK_DATA.filter(item => item.code && item.code.startsWith('orphan_'));

    const buildTree = (items, parentId = null) => {
      return items
        .filter(item => item.parentListId === parentId)
        .map(item => {
          const children = buildTree(items, item.id);
          return { ...item, children: children };
        });
    };

    setCategories(buildTree(normalData));
    setDetachedItems(orphanData.map(item => ({ ...item, isProduct: item.code.includes('_product_') })));
  };

  useEffect(() => { fetchLookups(); }, []); 

  const toggleCat = (id) => setExpandedCats(prev => prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]);
  const toggleSub = (id) => setExpandedSubs(prev => prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]);

  // 2. Add Modal Handlers
  const openModal = (mode, parent = null) => {
    setModalMode(mode);
    setActiveParent(parent);
    setFormData({ name: '' });
    setIsIndependent(false);
    setIndependentType('sub');
    setIsModalOpen(true);
  };

  const handleSave = () => {
    if (!formData.name.trim()) return toast.error('Name is required');

    const finalParentId = isIndependent ? null : (activeParent ? activeParent.id : null);
    let finalCode = formData.name.toLowerCase().replace(/\s+/g, '_');
    if (isIndependent) finalCode = `orphan_${independentType}_${finalCode}`;

    const apiPayload = {
      id: 0,
      code: finalCode,
      name: formData.name,
      parentListId: finalParentId,
      userId: -1
    };

    /* ⭐ REAL POST API ⭐
    await axios.post(`https://localhost:7214/api/Lookup/LookupListSave`, apiPayload);
    */

    // Mock Save
    MOCK_DATA.push({
      ...apiPayload,
      id: Math.floor(Math.random() * 10000) + 100,
      parentListName: activeParent ? activeParent.name : ""
    });

    toast.success('Saved successfully!');
    setIsModalOpen(false);
    fetchLookups(); 
  };

  // 3. Link Modal Handlers
  const openLinkModal = (item) => {
    setEditingItem(item);
    setSelectedParentId(""); 
    setIsLinkModalOpen(true);
  };

  const handleLinkSave = () => {
    if (!selectedParentId) return toast.error("Please select a parent");

    const itemIndex = MOCK_DATA.findIndex(i => i.id === editingItem.id);
    if (itemIndex > -1) {
      const item = MOCK_DATA[itemIndex];
      const cleanCode = item.code.replace(/^orphan_(sub|product)_/, ''); 
      
      const apiPayload = {
        id: item.id, 
        code: cleanCode,
        name: item.name,
        parentListId: Number(selectedParentId),
        userId: -1
      };

      /* ⭐ REAL UPDATE API ⭐
      await axios.post(`https://localhost:7214/api/Lookup/LookupListSave`, apiPayload);
      */

      // Mock Update
      MOCK_DATA[itemIndex] = { ...item, parentListId: Number(selectedParentId), code: cleanCode };
      
      toast.success('Item connected successfully!');
      setIsLinkModalOpen(false);
      fetchLookups(); 
    }
  };

  // Helper for Dropdowns
  const getCategoryOptions = () => categories.map(c => ({ value: c.id, label: c.name }));
  const getSubCategoryOptions = () => {
    let subs = [];
    categories.forEach(cat => {
      if (cat.children) cat.children.forEach(sub => subs.push({ value: sub.id, label: `${cat.name} > ${sub.name}` }));
    });
    return subs;
  };

  return (
    <div className="wf-page">
      {/* HEADER */}
      <div className="wf-header">
        <div>
          <h1 className="wf-title">Categories & Products</h1>
          <p className="wf-subtitle">Manage hierarchy (Mock Data Mode)</p>
        </div>
        <button className="wf-btn wf-btn--primary" onClick={() => openModal('category')}>
          <Plus size={16} /> Add Category
        </button>
      </div>

      {/* SECTION 1: MAIN TREE */}
      <div className="wf-card" style={{ overflow: 'hidden', marginBottom: '24px' }}>
        <div style={{ padding: '16px 20px', borderBottom: '1px solid #E2E8F0', background: '#F8FAFC' }}>
          <h2 style={{ fontSize: '16px', fontWeight: 600, color: '#1E293B', margin: 0 }}>Active Hierarchy</h2>
        </div>
        {categories.map(cat => {
          const isCatOpen = expandedCats.includes(cat.id);
          return (
            <div key={cat.id} style={{ borderBottom: '1px solid #E2E8F0' }}>
              <div style={{ display: 'flex', alignItems: 'center', padding: '16px 20px', background: isCatOpen ? '#F8FAFC' : '#fff', cursor: 'pointer' }} onClick={() => toggleCat(cat.id)}>
                <div style={{ width: 24, color: '#64748B' }}>{isCatOpen ? <ChevronDown size={18} /> : <ChevronRight size={18} />}</div>
                <Folder size={18} color="var(--primary-red)" style={{ marginRight: 12 }} />
                <div style={{ flex: 1, fontWeight: 600, fontSize: 15, color: '#0F172A' }}>{cat.name}</div>
                <button className="wf-btn wf-btn--secondary" style={{ marginLeft: 16, padding: '4px 12px', fontSize: 12 }} onClick={(e) => { e.stopPropagation(); openModal('sub', cat); }}>
                  <Plus size={12} /> Add Sub
                </button>
              </div>
              {isCatOpen && (
                <div style={{ padding: '0 20px 16px 56px' }}>
                  {cat.children.map(sub => {
                    const isSubOpen = expandedSubs.includes(sub.id);
                    return (
                      <div key={sub.id} style={{ marginTop: 8, border: '1px solid #E2E8F0', borderRadius: 8, overflow: 'hidden' }}>
                        <div style={{ display: 'flex', alignItems: 'center', padding: '10px 16px', background: '#fff', cursor: 'pointer' }} onClick={() => toggleSub(sub.id)}>
                          <div style={{ width: 20, color: '#94A3B8' }}>{isSubOpen ? <ChevronDown size={16} /> : <ChevronRight size={16} />}</div>
                          <Layers size={16} color="#64748B" style={{ marginRight: 10 }} />
                          <div style={{ flex: 1, fontWeight: 500, fontSize: 14 }}>{sub.name}</div>
                          <button className="wf-btn wf-btn--ghost" style={{ fontSize: 12, padding: '4px 8px' }} onClick={(e) => { e.stopPropagation(); openModal('product', sub); }}>
                            <Plus size={12} /> Add Product
                          </button>
                        </div>
                        {isSubOpen && (
                          <div style={{ background: '#F8FAFC', padding: '8px 16px 12px 46px' }}>
                            {sub.children.length === 0 ? <div style={{ fontSize: 12, color: '#94A3B8' }}>No products.</div> : 
                              sub.children.map(prod => (
                                <div key={prod.id} style={{ display: 'flex', alignItems: 'center', padding: '6px 0', fontSize: 13 }}>
                                  <Tag size={14} color="#94A3B8" style={{ marginRight: 10 }} />
                                  <div style={{ flex: 1, color: '#334155' }}>{prod.name}</div>
                                </div>
                              ))
                            }
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </div>

      {/* SECTION 2: UNLINKED ITEMS */}
      {detachedItems.length > 0 && (
        <div className="wf-card" style={{ border: '1px solid #FCD34D', overflow: 'hidden' }}>
          <div style={{ padding: '16px 20px', borderBottom: '1px solid #FDE68A', background: '#FEF3C7', display: 'flex', alignItems: 'center', gap: '8px' }}>
            <Unlink size={18} color="#D97706" />
            <h2 style={{ fontSize: '16px', fontWeight: 600, color: '#B45309', margin: 0 }}>Unlinked Items</h2>
          </div>
          <div style={{ padding: '20px' }}>
            {detachedItems.map(item => (
              <div key={item.id} style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '12px 16px', background: '#FFFBEB', border: '1px solid #FDE68A', borderRadius: '8px', marginBottom: '10px' }}>
                
                <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                  {item.isProduct ? <Tag size={18} color="#D97706" /> : <Layers size={18} color="#D97706" />}
                  <div>
                    <div style={{ fontWeight: 600, color: '#78350F' }}>{item.name}</div>
                    <div style={{ fontSize: '12px', color: '#B45309' }}>Type: {item.isProduct ? 'Product' : 'Sub-category'}</div>
                  </div>
                </div>

                <button 
                  className="wf-btn wf-btn--secondary" 
                  style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '6px 12px', fontSize: '13px', borderColor: '#FCD34D', color: '#B45309', background: '#FFF' }}
                  onClick={() => openLinkModal(item)}
                >
                  <Edit size={14} /> Connect
                </button>
                
              </div>
            ))}
          </div>
        </div>
      )}

      {/* MODAL 1: ADD NEW ITEM */}
      <Modal 
        open={isModalOpen} onClose={() => setIsModalOpen(false)} 
        title={isIndependent ? 'Add Independent Item' : (modalMode === 'category' ? 'Add New Category' : modalMode === 'sub' ? `Add Sub to "${activeParent?.name}"` : `Add Product to "${activeParent?.name}"`)}
        footer={
          <>
            <button className="wf-btn wf-btn--secondary" onClick={() => setIsModalOpen(false)}>Cancel</button>
            <button className="wf-btn wf-btn--primary" onClick={handleSave}>Save</button>
          </>
        }
      >
        {/* Toggle Switch */}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '12px 16px', background: '#F8FAFC', borderRadius: '8px', border: '1px solid #E2E8F0', marginBottom: '20px' }}>
          <div style={{ display: 'flex', flexDirection: 'column' }}>
            <span style={{ fontSize: '14px', fontWeight: 600, color: '#334155' }}>Create as Detached Item</span>
            <span style={{ fontSize: '12px', color: '#64748B' }}>Save this without a parent</span>
          </div>
          <label style={{ position: 'relative', display: 'inline-block', width: '46px', height: '24px', cursor: 'pointer', margin: 0 }}>
            <input type="checkbox" checked={isIndependent} onChange={(e) => setIsIndependent(e.target.checked)} style={{ opacity: 0, width: 0, height: 0 }} />
            <span style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, backgroundColor: isIndependent ? 'var(--primary-red)' : '#CBD5E1', transition: '.3s', borderRadius: '24px' }}>
              <span style={{ position: 'absolute', height: '18px', width: '18px', left: isIndependent ? '24px' : '4px', bottom: '3px', backgroundColor: 'white', transition: '.3s', borderRadius: '50%' }}></span>
            </span>
          </label>
        </div>

        {/* Conditional Fields */}
        {isIndependent && (
          <div style={{ padding: '16px', background: '#FEF2F2', border: '1px solid #FCA5A5', borderRadius: '8px', marginBottom: '20px' }}>
            <div style={{ display: 'flex', alignItems: 'flex-start', gap: '10px', marginBottom: '12px' }}>
              <AlertTriangle size={20} color="#DC2626" style={{ marginTop: 2 }} />
              <div>
                <h4 style={{ margin: 0, fontSize: '14px', fontWeight: 600, color: '#991B1B' }}>Make this independent (Parent ID null)</h4>
              </div>
            </div>
            <div className="wf-field" style={{ marginBottom: 0 }}>
              <label className="wf-label" style={{ fontSize: '13px', color: '#991B1B' }}>What is this item?</label>
              <select className="wf-select" value={independentType} onChange={(e) => setIndependentType(e.target.value)} style={{ borderColor: '#FCA5A5', background: '#FFF' }}>
                <option value="sub">Sub-category (Detached)</option>
                <option value="product">Product (Detached)</option>
              </select>
            </div>
          </div>
        )}

        <div className="wf-field">
          <label className="wf-label">{isIndependent ? `${independentType === 'sub' ? 'Sub-category' : 'Product'} Name` : (modalMode === 'category' ? 'Category Name' : modalMode === 'sub' ? 'Sub-category Name' : 'Product Name')} <span className="wf-label__req"> *</span></label>
          <input className="wf-input" value={formData.name} onChange={e => setFormData({ name: e.target.value })} placeholder="e.g. Complaint" autoFocus />
        </div>
      </Modal>

      {/* MODAL 2: CONNECT UNLINKED ITEM */}
      <Modal 
        open={isLinkModalOpen} 
        onClose={() => setIsLinkModalOpen(false)} 
        title={`Connect "${editingItem?.name}"`}
        footer={
          <>
            <button className="wf-btn wf-btn--secondary" onClick={() => setIsLinkModalOpen(false)}>Cancel</button>
            <button className="wf-btn wf-btn--primary" onClick={handleLinkSave} disabled={!selectedParentId} style={{ background: '#D97706' }}>
              <LinkIcon size={16} style={{ marginRight: '6px' }}/> Connect
            </button>
          </>
        }
      >
        <div style={{ padding: '16px', background: '#FFFBEB', border: '1px solid #FDE68A', borderRadius: '8px', marginBottom: '20px' }}>
          <div style={{ fontSize: '14px', color: '#92400E', marginBottom: '4px' }}>
            <strong>Item Type:</strong> {editingItem?.isProduct ? 'Product' : 'Sub-category'}
          </div>
          <div style={{ fontSize: '12px', color: '#B45309' }}>
            Select a parent below to link this item to the main hierarchy.
          </div>
        </div>

                <div className="wf-field">
          <label className="wf-label">Select Parent <span className="wf-label__req">*</span></label>
          
          {/* ⭐ Wrapper div for positioning ⭐ */}
          <div style={{ position: 'relative', width: '100%' }}>
            
            <select 
              className="wf-select" 
              value={selectedParentId} 
              onChange={(e) => setSelectedParentId(e.target.value)}
              // ⭐ Default arrow hatane ke liye appearance none ⭐
              style={{ 
                appearance: 'none', 
                WebkitAppearance: 'none', 
                MozAppearance: 'none', 
                paddingRight: '40px', // Arrow ke liye jagah
                width: '100%'
              }}
            >
              <option value="" disabled>-- Choose a {editingItem?.isProduct ? 'Sub-category' : 'Category'} --</option>
              {editingItem?.isProduct ? 
                getSubCategoryOptions().map(opt => <option key={opt.value} value={opt.value}>{opt.label}</option>) 
                : 
                getCategoryOptions().map(opt => <option key={opt.value} value={opt.value}>{opt.label}</option>)
              }
            </select>

            {/* ⭐ Custom Arrow Icon ⭐ */}
            <div style={{ 
              position: 'absolute', 
              right: '12px', 
              top: '50%', 
              transform: 'translateY(-50%)', 
              pointerEvents: 'none', // Click select pe hi jaye, arrow pe nahi
              color: '#64748B' 
            }}>
              <ChevronDown size={18} />
            </div>

          </div>
        </div>
      </Modal>

    </div>
  );
}



















npm install antd @ant-design/icons lucide-react dayjs react-hot-toast