/* ================= My Team Page Specific ================= */

/* --- Top Metrics Grid --- */
.mt-metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 24px;
}

.mt-metric-card {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mt-metric-value {
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
}

/* Custom colors for metric numbers */
.mt-val-red { color: var(--primary-red); }
.mt-val-dark { color: #1f2937; }
.mt-val-green { color: #16a34a; }
.mt-val-orange { color: #d97706; }

.mt-metric-label {
  font-size: 13px;
  color: #6b7280;
  font-weight: 500;
}

.mt-metric-label span {
  color: #9ca3af;
  font-weight: 400;
}

/* --- Search Bar --- */
.mt-search-container {
  width: 350px;
  margin-bottom: 20px;
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  display: flex;
  align-items: center;
  padding: 10px 12px;
  gap: 8px;
}

.mt-search-container input {
  border: none;
  background: transparent;
  padding: 0;
  font-size: 13px;
  outline: none;
  width: 100%;
}

/* --- Table Container --- */
.mt-table-container {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 16px;
}

.mt-table-header {
  display: flex;
  padding: 14px 20px;
  background: #f9fafb;
  font-size: 12px;
  font-weight: 600;
  color: #9ca3af;
  border-bottom: 1px solid var(--border-color);
  letter-spacing: 0.5px;
  align-items: center;
}

.mt-table-row {
  display: flex;
  padding: 16px 20px;
  align-items: center;
  border-bottom: 1px solid var(--border-color);
  transition: background 0.2s;
}

.mt-table-row:hover {
  background: #f9fafb;
}

.mt-table-row:last-child {
  border-bottom: none;
}

/* --- Officer Info --- */
.mt-officer-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.mt-avatar {
  width: 36px;
  height: 36px;
  background: var(--primary-red);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  flex-shrink: 0;
}

.mt-officer-name {
  font-weight: 600;
  font-size: 14px;
  color: var(--text-main);
}

.mt-officer-role {
  font-size: 12px;
  color: #9ca3af;
}

/* --- Progress Bar --- */
.mt-progress-wrapper {
  flex: 1;
  max-width: 250px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.mt-progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-progress-text {
  font-size: 12px;
  color: #6b7280;
}

.mt-progress-track {
  width: 100%;
  height: 6px;
  background: #e5e7eb;
  border-radius: 3px;
  overflow: hidden;
}

.mt-progress-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.3s ease;
}

/* Progress Bar Colors */
.bg-green { background-color: #16a34a; }
.bg-orange { background-color: #d97706; }
.bg-red { background-color: #dc2626; }

/* --- Badges & Text --- */
.mt-badge-ontarget {
  background: #dcfce7;
  color: #15803d;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
}

.mt-badge-overdue {
  background: #fee2e2;
  color: #b91c1c;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
}

.mt-tat-text {
  font-size: 13px;
  font-weight: 500;
}

.mt-tat-green { color: #16a34a; }
.mt-tat-orange { color: #d97706; }
.mt-tat-gray { color: #9ca3af; }

/* --- Footer Info Banner --- */
.mt-info-banner {
  background: #f9fafb;
  border: 1px solid var(--border-color);
  padding: 12px 20px;
  border-radius: 6px;
  font-size: 13px;
  color: #6b7280;
  margin-bottom: 32px;
}

/* --- Team Lead Card (Bottom) --- */
.mt-lead-section {
  margin-top: 32px;
}

.mt-lead-label {
  font-size: 12px;
  color: #9ca3af;
  font-weight: 600;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.mt-lead-card {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mt-lead-avatar {
  width: 36px;
  height: 36px;
  background: #fca5a5; /* Lighter red for TL */
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
}

.mt-lead-managing {
  font-size: 13px;
  color: #6b7280;
}
